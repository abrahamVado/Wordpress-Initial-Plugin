{
  "name": "abraham-gomez/demo-plugin",
  "description": "Demo Plugin scaffolding with PSR-4, CPT, and OAuth-only REST routes.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "DemoPlugin\\": "includes/"
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "scripts": {
    "lint": "phpcs -p",
    "lint:fix": "phpcbf -p"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.x-dev"
    }
  }
}